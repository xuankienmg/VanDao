<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Cửa sổ desktop (WinForms + WebView2) nên cần target Windows -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VanDao</RootNamespace>
    <AssemblyName>NguoiLuoiTuTien</AssemblyName>
    <Title>Người Lười Tu Tiên</Title>
    <Product>Người Lười Tu Tiên</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>wwwroot\img\app\icon.ico</ApplicationIcon>
    <!-- Phiên bản phát hành: tăng số này mỗi lần gửi bản chơi thử mới -->
    <Version>0.7.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\img\app\icon.ico" LogicalName="VanDao.AppIcon.ico" />
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- công cụ mô phỏng cân bằng (project riêng): không biên dịch vào game -->
    <Compile Remove="tools\**" />
    <Content Remove="tools\**" />
    <None Remove="tools\**" />
    <!-- launcher: project riêng, không biên dịch vào game -->
    <Compile Remove="VanDaoLauncher\**" />
    <Content Remove="VanDaoLauncher\**" />
    <None Remove="VanDaoLauncher\**" />
  </ItemGroup>

</Project>
