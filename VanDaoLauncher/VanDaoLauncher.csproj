<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VanDao.Launcher</RootNamespace>
    <AssemblyName>VanDaoLauncher</AssemblyName>
    <Title>Vạn Đạo Launcher</Title>
    <Product>Vạn Đạo Launcher</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\wwwroot\img\app\icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Publish kèm .NET runtime để người chơi không phải cài .NET riêng. -->
  <PropertyGroup Condition="'$(PublishDir)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\wwwroot\img\app\icon.ico" LogicalName="VanDao.Launcher.AppIcon.ico" />
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="**\launcher_settings.json" />
    <None Remove="**\launcher_settings.json" />
  </ItemGroup>

</Project>
